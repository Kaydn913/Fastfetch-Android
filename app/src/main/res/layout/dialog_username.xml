<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:maxHeight="720dp"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:fontFamily="@font/quicksand_regular"
            android:id="@+id/dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:fontFamily="@font/quicksand_regular"
            android:id="@+id/dialog_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#BDBDBD"
            android:textSize="13sp" />

        <EditText
            android:fontFamily="@font/quicksand_regular"
            android:id="@+id/username_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="Username"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777" />

        <TextView
            android:id="@+id/username_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/quicksand_regular"
            android:textColor="#00D2FF"
            android:textSize="13sp" />

        <TextView
            android:fontFamily="@font/quicksand_regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Output preset"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/preset_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <Switch
            android:fontFamily="@font/quicksand_regular"
            android:id="@+id/show_logo_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="Show Android ASCII logo"
            android:textColor="#FFFFFF" />

        <TextView
            android:fontFamily="@font/quicksand_regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Accent color"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/accent_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:fontFamily="@font/quicksand_regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Info font"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/font_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:fontFamily="@font/quicksand_regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Live refresh"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/refresh_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <TextView
            android:fontFamily="@font/quicksand_regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Modules"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Switch
            android:fontFamily="@font/quicksand_regular"
            android:id="@+id/module_display_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Display"
            android:textColor="#FFFFFF" />

        <Switch
            android:fontFamily="@font/quicksand_regular"
            android:id="@+id/module_hardware_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hardware"
            android:textColor="#FFFFFF" />

        <Switch
            android:fontFamily="@font/quicksand_regular"
            android:id="@+id/module_graphics_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Graphics"
            android:textColor="#FFFFFF" />

        <Switch
            android:fontFamily="@font/quicksand_regular"
            android:id="@+id/module_memory_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Memory / storage"
            android:textColor="#FFFFFF" />

        <Switch
            android:fontFamily="@font/quicksand_regular"
            android:id="@+id/module_network_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Network"
            android:textColor="#FFFFFF" />

        <Switch
            android:fontFamily="@font/quicksand_regular"
            android:id="@+id/module_power_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Power / thermals"
            android:textColor="#FFFFFF" />

        <Switch
            android:fontFamily="@font/quicksand_regular"
            android:id="@+id/module_android_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Android / runtime"
            android:textColor="#FFFFFF" />

        <Switch
            android:fontFamily="@font/quicksand_regular"
            android:id="@+id/module_security_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Security"
            android:textColor="#FFFFFF" />

        <Switch
            android:fontFamily="@font/quicksand_regular"
            android:id="@+id/module_misc_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Misc"
            android:textColor="#FFFFFF" />

        <TextView
            android:fontFamily="@font/quicksand_regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Module order"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:fontFamily="@font/quicksand_regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Use: display, hardware, graphics, memory, network, power, android, security, misc"
            android:textColor="#8F8F8F"
            android:textSize="11sp" />

        <EditText
            android:fontFamily="@font/quicksand_regular"
            android:id="@+id/module_order_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/reset_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:fontFamily="@font/quicksand_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="5dp"
                android:text="Reset"
                android:textAllCaps="false"
                android:textSize="14sp" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/cancel_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:fontFamily="@font/quicksand_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="5dp"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textSize="14sp" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/save_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:fontFamily="@font/quicksand_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="5dp"
                android:text="Save"
                android:textAllCaps="false"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
