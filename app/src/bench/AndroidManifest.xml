<?xml version="1.0" encoding="utf-8"?>
<!-- Bench builds only: lets Perfetto and simpleperf profile the app from
     adb shell without making it debuggable (debuggable builds run slower,
     which would skew the numbers). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <profileable
            android:shell="true"
            tools:targetApi="29" />
    </application>

</manifest>
